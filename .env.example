APP_NAME=AfriDish
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=error
APP_URL=https://example.com

# Railway's MySQL plugin fills these in automatically when linked -
# for any other host, point them at your own MySQL instance.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (Website/StripePaymentController)
STRIPE_KEY=
STRIPE_SECRET=

# Third-party payment API used directly in Website/OrderController and
# SubscriptionController for checkout (separate from the Stripe/PayPal
# integrations below) - a base URL and bearer token for that provider.
PAYMENT_URL=
SECRET_KEY=

# PayPal (league/omnipay-paypal)
PAYPAL_USERNAME=
PAYPAL_PASSWORD=
PAYPAL_SIGNATURE=
PAYPAL_SANDBOX=true

# Google login (laravel/socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Facebook login (laravel/socialite)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_URL=

# Push notifications (app/Services/FcmService.php) - a service account
# JSON from Firebase console -> Project settings -> Service accounts.
# Upload it to the host and point FCM_CREDENTIALS_PATH at its path,
# or set FCM_CREDENTIALS_PATH to storage/app/firebase-service-account.json
# and place the file there (storage/app/ is gitignored).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
